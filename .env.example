# Proveedor LLM compatible con OpenAI (Google Gemini por defecto)
LLM_PROVIDER=gemini
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
LLM_MODEL=gemini-3.8-flash
# Alternativas (solo cambian estas variables):
#   Groq:       LLM_BASE_URL=https://api.groq.com/openai/v1  LLM_MODEL=llama-3.3-70b-versatile
#   OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1  LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
#   Ollama:     LLM_BASE_URL=http://localhost:11434/v1     LLM_MODEL=llama3.1

# Límites de costo y robustez
MAX_ITERATIONS=25
MAX_TOKENS_SESSION=200000
LLM_TIMEOUT_MS=30000
RATE_LIMIT_PER_MIN=20

# Servidor
PORT=3000
# Opcional: si se define, el front pide esta clave para usar el chat
ACCESS_KEY=
